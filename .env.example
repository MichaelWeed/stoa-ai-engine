# ── Provider ──────────────────────────────────────────────────────────────────
# Which AI provider powers the planning step. The model is only called ONCE
# to generate a plan; all actual work is done by deterministic code after that.
#
# Options: openai | anthropic | google | ollama (local)
STOA_PROVIDER=openai

# Your API key. Never committed. Loaded ephemerally at runtime, never logged.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# Model to use for the planning step (default shown).
# Swap this without touching any code.
STOA_MODEL=gpt-4o

# ── Budget guardrails ──────────────────────────────────────────────────────────
# Hard limits per task. Stoa halts and returns a structured error if exceeded.
STOA_MAX_STEPS=25
STOA_TOKEN_BUDGET=50000        # tokens per task
STOA_STEP_TIMEOUT_SECONDS=30   # per individual step

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Execution backend: docker (default, recommended) | subprocess (no Docker required)
STOA_SANDBOX=docker
STOA_SANDBOX_TIMEOUT_SECONDS=60
STOA_SANDBOX_MEMORY_MB=256

# ── Storage ───────────────────────────────────────────────────────────────────
STOA_DB_URL=sqlite+aiosqlite:///stoa.db

# ── API server ────────────────────────────────────────────────────────────────
STOA_API_HOST=127.0.0.1
STOA_API_PORT=8000
